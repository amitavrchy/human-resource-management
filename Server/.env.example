# Native NestJS service. Docker uses the repository root .env instead.
DATABASE_URL=postgresql://peopleos:replace-with-your-database-password@127.0.0.1:5432/peopleos?schema=public
JWT_SECRET=replace-with-at-least-32-random-characters
AI_SERVICE_TOKEN=replace-with-the-same-random-token-as-the-ai-service
PORT=4000
CLIENT_ORIGIN=http://localhost:3000
AI_SERVICE_URL=http://127.0.0.1:8001
UPLOAD_DIR=./uploads
TRUST_PROXY=0
# Required only when explicitly seeding a demo organization.
DEMO_PASSWORD=
