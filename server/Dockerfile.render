FROM node:24-bookworm-slim

ENV DEBIAN_FRONTEND=noninteractive \
    PGDATA=/var/lib/postgresql/data \
    POSTGRES_USER=peopleos \
    POSTGRES_PASSWORD=peopleos \
    POSTGRES_DB=peopleos \
    PORT=10000 \
    ALLOW_DEMO_SEED=true \
    DATABASE_URL=postgresql://peopleos:peopleos@127.0.0.1:5432/peopleos?schema=public

RUN apt-get update \
  && apt-get install -y --no-install-recommends \
       postgresql postgresql-contrib \
       openssl ca-certificates curl gosu \
  && rm -rf /var/lib/apt/lists/* \
  && mkdir -p /var/run/postgresql "$PGDATA" \
  && chown -R postgres:postgres /var/run/postgresql "$PGDATA"

WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci --include=dev --ignore-scripts

COPY . .
# Build needs more heap than free-tier runtime; runtime NODE_OPTIONS set below.
RUN NODE_OPTIONS=--max-old-space-size=1536 npx prisma generate \
  && NODE_OPTIONS=--max-old-space-size=1536 npx nest build \
  && mkdir -p /app/uploads \
  && chmod +x /app/docker-entrypoint-render.sh \
  && npm prune --omit=dev

ENV NODE_ENV=production \
    NODE_OPTIONS=--max-old-space-size=192

EXPOSE 10000
ENTRYPOINT ["/app/docker-entrypoint-render.sh"]