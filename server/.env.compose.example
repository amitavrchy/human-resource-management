# Docker Compose environment. From server/, generate secrets with npm run setup:env.
POSTGRES_PASSWORD=replace-with-a-random-hex-password
POSTGRES_DB=peopleos
JWT_SECRET=replace-with-at-least-32-random-characters
AI_SERVICE_TOKEN=replace-with-the-same-service-token-used-by-api-and-ai
CLIENT_ORIGIN=http://localhost:3000
WEB_BIND_ADDRESS=127.0.0.1
WEB_PORT=3000
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# Optional, only for an explicitly seeded development/demo workspace.
DEMO_PASSWORD=
